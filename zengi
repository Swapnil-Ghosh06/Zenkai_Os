#!/bin/bash
# ==============================================================================
# ZENGI OS MASTER CLI — Virtual Machine Runner & Controller
# Author: Swapnil Ghosh 25BTRCL267 AIML-E
# ==============================================================================

set -euo pipefail

# Ensure environment paths are set
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env" 2>/dev/null || true
fi

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

OVMF_PATH="$PROJECT_DIR/ovmf/OVMF.fd"
ESP_DIR="/tmp/zengi-esp"

# Check QEMU binary
QEMU_BIN=""
if command -v qemu-system-x86_64 &>/dev/null; then
    QEMU_BIN="qemu-system-x86_64"
elif [ -f "/opt/homebrew/bin/qemu-system-x86_64" ]; then
    QEMU_BIN="/opt/homebrew/bin/qemu-system-x86_64"
elif [ -f "/usr/local/bin/qemu-system-x86_64" ]; then
    QEMU_BIN="/usr/local/bin/qemu-system-x86_64"
else
    echo -e "\x1b[31m[-] Error: qemu-system-x86_64 not found. Please run: brew install qemu\x1b[0m"
    exit 1
fi

build_kernel() {
    echo -e "\x1b[36m[*] Compiling Zengi OS release binary (x86_64-unknown-uefi)...\x1b[0m"
    cargo build --release --target x86_64-unknown-uefi
    rm -rf "$ESP_DIR"
    mkdir -p "$ESP_DIR/EFI/BOOT"
    cp "target/x86_64-unknown-uefi/release/zengi_os.efi" "$ESP_DIR/EFI/BOOT/BOOTX64.EFI"
    # Set 4-second boot menu countdown so user can hit Enter or it boots automatically
    cat << 'EOF' > "$ESP_DIR/EFI/BOOT/zengi.cfg"
timeout=4
EOF
    echo -e "\x1b[32m[+] Zengi OS EFI binary staged at: $ESP_DIR/EFI/BOOT/BOOTX64.EFI\x1b[0m"
}

case "${1:-gui}" in
    gui|window|-g|--gui|"")
        build_kernel
        echo -e "\x1b[32m[*] Launching Zengi OS in Graphical Virtual Machine Window (Cocoa)...\x1b[0m"
        echo -e "\x1b[33m[+] Look at the QEMU window on your screen: 'ZENGI OS' will display prominently!\x1b[0m"
        echo -e "\x1b[90m(Press Enter in the QEMU window to boot immediately, or wait 4 seconds)\x1b[0m\n"
        "$QEMU_BIN" \
            -machine q35 \
            -m 256M \
            -drive if=pflash,format=raw,readonly=on,file="$OVMF_PATH" \
            -drive format=raw,file=fat:rw:"$ESP_DIR" \
            -serial stdio \
            -display cocoa \
            -no-reboot
        ;;
    run|terminal|-t|--terminal)
        build_kernel
        echo -e "\x1b[33m[*] Starting Zengi OS in Interactive Terminal Mode...\x1b[0m"
        echo -e "\x1b[90m(To exit QEMU, press Ctrl+A then X)\x1b[0m\n"
        "$QEMU_BIN" \
            -machine q35 \
            -m 256M \
            -drive if=pflash,format=raw,readonly=on,file="$OVMF_PATH" \
            -drive format=raw,file=fat:rw:"$ESP_DIR" \
            -nographic \
            -no-reboot
        ;;
    test|verify|check)
        build_kernel
        echo -e "\x1b[36m[*] Running Automated Verification Suite for Zengi OS...\x1b[0m"
        python3 "$PROJECT_DIR/test_runner.py"
        ;;
    help|--help|-h)
        echo "Zengi OS Master CLI"
        echo "Usage: ./zengi [command]"
        echo ""
        echo "Commands:"
        echo "  ./zengi          - Launch Zengi OS in Graphical Virtual Machine Window (Cocoa)"
        echo "  ./zengi terminal - Run Zengi OS inside terminal"
        echo "  ./zengi test     - Run automated verification tests"
        echo "  ./zengi help     - Show this help menu"
        ;;
    *)
        echo -e "\x1b[31m[-] Unknown command '$1'. Run './zengi help' for options.\x1b[0m"
        exit 1
        ;;
esac
