#!/bin/bash
# ==============================================================================
# ZENKAI OS MASTER CLI — Virtual Machine & Research Control Center
# Author: Swapnil Ghosh 25BTRCL267 AIML-E
# ==============================================================================

set -euo pipefail

# Ensure environment paths are set
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env" 2>/dev/null || true
fi

PROJECT_DIR="/Users/swapnil/Code With Swap/Zenkai_Os"
cd "$PROJECT_DIR"

OVMF_PATH="$PROJECT_DIR/ovmf/OVMF.fd"
ESP_DIR="/tmp/zenkai-esp"

# Check QEMU binary
QEMU_BIN=""
if command -v qemu-system-x86_64 &>/dev/null; then
    QEMU_BIN="qemu-system-x86_64"
elif [ -f "/opt/homebrew/bin/qemu-system-x86_64" ]; then
    QEMU_BIN="/opt/homebrew/bin/qemu-system-x86_64"
elif [ -f "/usr/local/bin/qemu-system-x86_64" ]; then
    QEMU_BIN="/usr/local/bin/qemu-system-x86_64"
else
    echo -e "\x1b[31m[-] Error: qemu-system-x86_64 not found. Please run: brew install qemu\x1b[0m"
    exit 1
fi

build_kernel() {
    echo -e "\x1b[36m[*] Scanning live nearby Wi-Fi networks using host device adapter...\x1b[0m"
    python3 "$PROJECT_DIR/tools/scan_wifi.py" || true
    echo -e "\x1b[36m[*] Compiling Zenkai OS release binary (x86_64-unknown-uefi)...\x1b[0m"
    cargo build --release --target x86_64-unknown-uefi
    mkdir -p "$ESP_DIR/EFI/BOOT"
    cp "target/x86_64-unknown-uefi/release/zenkai_os.efi" "$ESP_DIR/EFI/BOOT/BOOTX64.EFI"
    if [ -f "$PROJECT_DIR/wifi_scan.txt" ]; then
        cp "$PROJECT_DIR/wifi_scan.txt" "$ESP_DIR/EFI/BOOT/wifi_scan.txt"
        cp "$PROJECT_DIR/wifi_scan.txt" "$ESP_DIR/wifi_scan.txt"
    fi
    echo -e "\x1b[32m[+] Zenkai OS binary ready: target/x86_64-unknown-uefi/release/zenkai_os.efi\x1b[0m"
}

MODE="${1:-gui}"

case "$MODE" in
    gui|run|window)
        build_kernel
        echo -e "\x1b[32m[*] Launching Zenkai OS in Virtual Machine Window (Cocoa Graphical Display)...\x1b[0m"
        echo -e "\x1b[36m[+] Author: Swapnil Ghosh 25BTRCL267 AIML-E\x1b[0m"
        echo -e "\x1b[33m[!] Tip: A macOS Virtual Machine window will open displaying the graphical boot screen.\x1b[0m\n"
        "$QEMU_BIN" \
            -machine q35 \
            -m 512M \
            -vga std \
            -drive if=pflash,format=raw,readonly=on,file="$OVMF_PATH" \
            -drive format=raw,file=fat:rw:"$ESP_DIR" \
            -serial stdio \
            -display cocoa \
            -no-reboot
        ;;
    terminal|-t|--terminal)
        build_kernel
        echo -e "\x1b[33m[*] Starting Zenkai OS in Headless Terminal Mode...\x1b[0m"
        echo -e "\x1b[90m(To exit QEMU, press Ctrl+A then X)\x1b[0m\n"
        "$QEMU_BIN" \
            -machine q35 \
            -m 256M \
            -drive if=pflash,format=raw,readonly=on,file="$OVMF_PATH" \
            -drive format=raw,file=fat:rw:"$ESP_DIR" \
            -nographic \
            -no-reboot
        ;;
    test|verify|check)
        echo -e "\x1b[36m[*] Running Automated Verification Suite...\x1b[0m"
        python3 "$PROJECT_DIR/test_runner.py"
        ;;
    live|iso|iso-boot)
        if [ ! -f "$PROJECT_DIR/zenkai_os_live.iso" ]; then
            echo -e "\x1b[33m[*] zenkai_os_live.iso not found. Building it now...\x1b[0m"
            bash "$PROJECT_DIR/build_iso.sh"
        fi
        echo -e "\x1b[32m[*] Booting actual Zenkai OS Live ISO (Hybrid UEFI image)...\x1b[0m"
        echo -e "\x1b[36m[+] Featuring GNU GRUB 2.12 UEFI Bootloader & 5-Stage Animated Splash\x1b[0m"
        echo -e "\x1b[33m[!] Author: Swapnil Ghosh 25BTRCL267 AIML-E\x1b[0m\n"
        "$QEMU_BIN" \
            -machine q35 \
            -m 512M \
            -vga std \
            -drive if=pflash,format=raw,readonly=on,file="$OVMF_PATH" \
            -cdrom "$PROJECT_DIR/zenkai_os_live.iso" \
            -boot d \
            -serial stdio \
            -display cocoa \
            -no-reboot
        ;;
    iso-doc|debian)
        echo -e "\x1b[36m[*] Displaying Debian Mini-OS ISO Packaging & Boot-Time Analysis...\x1b[0m"
        cat "$PROJECT_DIR/ISO_PACKAGING_AND_BOOT_ANALYSIS.md"
        ;;
    help|--help|-h)
        echo "Zenkai OS Control Center"
        echo "Usage: ./zenkai [command]"
        echo ""
        echo "Commands:"
        echo "  ./zenkai live     - Boot actual Live ISO with GNU GRUB boot menu & 5-stage splash"
        echo "  ./zenkai          - Launch Zenkai OS in Virtual Machine Window (Cocoa GUI)"
        echo "  ./zenkai terminal - Launch Zenkai OS in Headless Terminal mode"
        echo "  ./zenkai test     - Run automated verification tests"
        echo "  ./zenkai help     - Show this help menu"
        echo "  ./zenkai test     - Run automated verification tests"
        echo "  ./zenkai iso      - View Debian Mini-OS ISO packaging and boot-time benchmarks"
        echo "  ./zenkai help     - Show this help menu"
        ;;
    *)
        echo -e "\x1b[31m[-] Unknown command '$1'. Run './zenkai help' for options.\x1b[0m"
        exit 1
        ;;
esac
